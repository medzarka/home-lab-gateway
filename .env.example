# ==============================================================================
# Homelab Gateway Configuration (Tailscale + Traefik v3 + Cloudflare Tunnel)
# ==============================================================================

# --- 1. Base Storage Directory ---
# Host directory where persistent volumes for Tailscale and Traefik reside
GATEWAY_HOME=/srv/data/gateway

# --- 2. Tailscale Ingress Configuration ---
# Tailscale Auth Key (Reusable/Ephemeral from Tailscale Admin Console)
TS_AUTHKEY=tskey-auth-your_tailscale_auth_key_here

# Hostname displayed inside your Tailscale tailnet
TS_HOSTNAME=homelab-gw

# --- 3. Cloudflare Tunnel (Zero Trust Ingress) ---
# Cloudflare Tunnel Token (from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# --- 4. Shared Backbone Network ---
SHARED_NETWORK=shared_net

# Timezone (e.g. UTC, Europe/Paris, Africa/Tunis, America/New_York)
TZ=UTC
